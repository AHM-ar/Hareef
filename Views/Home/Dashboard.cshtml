@model IEnumerable<Hareef.Models.Artisan>

@{
    ViewData["Title"] = "لوحة التحكم - منصة حريف";
    string userName = ViewData["UserName"] as string ?? "مستخدم";
    string isAdmin = ViewData["IsAdmin"] as string;
    string searchQuery = ViewData["SearchQuery"] as string;
}

<div class="container py-5" dir="rtl">
    <!-- ترحيب بالمستخدم -->
    <div class="row mb-4 align-items-center">
        <div class="col-md-8">
            <h2 class="fw-bold text-primary">مرحباً بك، @userName 👋</h2>
            <p class="text-muted">هنا لوحة التحكم الخاصة بك، يمكنك تصفح الحرفيين والبحث عن المهن المطلوبة بسهولة.</p>
            @if (isAdmin == "True")
            {
                <span class="badge bg-danger p-2">حساب إداري (Admin)</span>
            }
        </div>
        <div class="col-md-4 text-md-end">
            <a class="btn btn-outline-danger" href="@Url.Action("Logout", "Account")">تسجيل الخروج</a>
        </div>
    </div>

    <!-- قسم القائمة المنسدلة للمعلومات الإرشادية -->
    <div class="card shadow-sm mb-4 border-0">
        <div class="card-header bg-light fw-bold text-dark" data-bs-toggle="collapse" href="#guidelinesCollapse" role="button" aria-expanded="false" aria-controls="guidelinesCollapse" style="cursor: pointer;">
            📋 معلومات إرشادية وتوجيهات استخدام المنصة (اضغط للعرض والطي)
        </div>
        <div class="collapse" id="guidelinesCollapse">
            <div class="card-body bg-white">
                <ul class="mb-0 text-secondary">
                    <li>استخدم خانة البحث أدناه للعثور على أي مهنة أو حرفي بسرعة (مثل: سباك، كهربائي، نجار).</li>
                    <li>تأكد من التواصل مع الحرفي عبر وسائل الاتصال المعتمدة داخل بطاقته الشخصية.</li>
                    <li>لإضافة خدمة جديدة أو تعديل بياناتك، يرجى مراجعة لوحة إدارة الحسابات أو التواصل مع الدعم الفني.</li>
                </ul>
            </div>
        </div>
    </div>

    <!-- خانة البحث عن مهنة -->
    <div class="card shadow-sm mb-5 border-0 bg-primary text-white p-4 rounded-4">
        <h4 class="mb-3">🔍 ابحث عن المهنة أو الحرفي الذي تحتاجه</h4>
        <form method="get" asp-action="Dashboard" class="row g-3">
            <div class="col-md-10">
                <input type="text" name="searchQuery" value="@searchQuery" class="form-control form-control-lg" placeholder="اكتب اسم المهنة (مثال: كهربائي، حداد، سباك)...">
            </div>
            <div class="col-md-2 d-grid">
                <button type="submit" class="btn btn-dark btn-lg fw-bold">بحث</button>
            </div>
        </form>
    </div>

    <!-- عرض البطاقات -->
    <h3 class="fw-bold mb-4 text-dark">قائمة الحرفيين والمهن المتاحة</h3>

    @if (Model != null && Model.Any())
    {
        <div class="row row-cols-1 row-cols-md-3 g-4">
            @foreach (var artisan in Model)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm border-0 rounded-4 overflow-hidden">
                        <div class="bg-primary text-white p-3 text-center">
                            <h5 class="card-title m-0 fw-bold">@artisan.Name</h5>
                            <span class="badge bg-light text-primary mt-2">@artisan.Profession</span>
                        </div>
                        <div class="card-body">
                            <p class="card-text text-muted">@artisan.Bio</p>
                            <hr />
                            <p class="small mb-1"><strong>البريد:</strong> @artisan.Email</p>
                            <p class="small mb-0"><strong>واتساب:</strong> @artisan.WhatsAppNumber</p>
                        </div>
                        <div class="card-footer bg-white border-0 pb-3 text-center">
                            <a href="https://wa.me/@artisan.WhatsAppNumber" target="_blank" class="btn btn-success w-100 rounded-pill">تواصل عبر واتساب</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-warning text-center py-4 rounded-4" role="alert">
            لا توجد نتائج مطابقة لبحثك أو أن قائمة الحرفيين فارغة حالياً.
        </div>
    }
</div>