@model Hareef.Models.User

@{
    ViewData["Title"] = "إنشاء حساب جديد";
}

<div class="container mt-5" style="max-width: 600px;">
    <h2 class="text-center mb-4">تسجيل حساب جديد وحرفي</h2>

    <form asp-action="Register" method="post" class="card p-4 shadow-sm">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="FullName" class="form-label">الاسم الكامل</label>
            <input asp-for="FullName" class="form-control" placeholder="أدخل اسمك الكامل" required />
            <span asp-validation-for="FullName" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Email" class="form-label">البريد الإلكتروني</label>
            <input asp-for="Email" type="email" class="form-control" placeholder="name@example.com" required />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Password" class="form-label">كلمة المرور</label>
            <input asp-for="Password" type="password" class="form-control" placeholder="********" required />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>

        <hr />
        <h5 class="mb-3 text-primary">بيانات البطاقة المهنية</h5>

        <div class="mb-3">
            <label class="form-label">المهنة / التخصص</label>
            <input type="text" name="Profession" class="form-control" placeholder="مثال: نجار مسلح، كهربائي..." required />
        </div>

        <div class="mb-3">
            <label class="form-label">رقم الواتساب</label>
            <input type="text" name="WhatsAppNumber" class="form-control" placeholder="مثال: 0097430796206" required />
        </div>

        <div class="mb-3">
            <label class="form-label">نبذة تعريفية</label>
            <textarea name="Bio" class="form-control" rows="3" placeholder="اكتب نبذة مختصرة عن خبرتك..."></textarea>
        </div>

        <div class="mb-3">
            <label class="form-label">رابط الصورة الشخصية</label>
            <input type="text" name="ProfileImage" class="form-control" placeholder="رابط مباشر للصورة أو مسارها" />
        </div>

        <button type="submit" class="btn btn-primary w-100 py-2">تسجيل الحساب وإنشاء البطاقة</button>
    </form>
</div>